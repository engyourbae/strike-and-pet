# Salin ke .env.local lalu isi dari Firebase Console > Project settings > Your apps > Web app.
# Nilai ini adalah konfigurasi PUBLIK (bukan rahasia); keamanan ada di Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=

# "/" untuk dev/domain root; "/nama-repo/" untuk GitHub Pages (diisi otomatis oleh workflow).
VITE_BASE=/

# true = sambungkan ke Firebase Emulator Suite (lokal)
VITE_USE_EMULATORS=false

# WAJIB untuk Live Location, indikator mengetik, dan status online (Build > Realtime Database).

# Opsional: tampil di Bantuan, Kebijakan Privasi, dan Syarat
VITE_SUPPORT_EMAIL=
VITE_OPERATOR_NAME=
